# === Environment ===
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# === Your university ===
# Used in Gloria's system prompt and in document metadata.
UNIVERSITY_NAME=Your University
UNIVERSITY_FULL_NAME=Your University, Your City
UNIVERSITY_SHORT_NAME=YU
UNIVERSITY_MOTTO=
ASSISTANT_CREATOR=Your Name

# === Database ===
# Local dev:  postgresql://gloria:change-me@localhost:5432/gloria
# In Docker:  postgresql://gloria:change-me@db:5432/gloria
DATABASE_URL=postgresql://gloria:change-me@db:5432/gloria

# === Vector store ===
CHROMA_DIR=./data/chroma
CHROMA_COLLECTION=gloria_kb

# === Embeddings ===
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# === Chunking ===
CHUNK_SIZE_TOKENS=300
CHUNK_OVERLAP_TOKENS=50

# === Generation (LLM) — OpenAI-compatible endpoint ===
# Examples:
#   OpenAI:   https://api.openai.com/v1        gpt-4o-mini  (or your ft:... id)
#   Groq:     https://api.groq.com/openai/v1   llama-3.1-70b-versatile
#   Together: https://api.together.xyz/v1      meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo
#   Ollama:   http://host.docker.internal:11434/v1   llama3
GLORIA_MODEL_BASE_URL=https://api.openai.com/v1
GLORIA_MODEL_API_KEY=sk-your-key-here
GLORIA_MODEL_NAME=gpt-4o-mini
GLORIA_MAX_TOKENS=800
GLORIA_TEMPERATURE=0.2
# Reasoning effort for "thinking" models; empty = automatic per model
# (Gemini 2.5 Flash: none, gpt-oss / other Gemini: low). "off" = never send.
GLORIA_REASONING_EFFORT=

# === Fallback LLM (optional) ===
# Used only when the primary call fails (e.g. Gemini free-tier rate limit).
# Leave GLORIA_FALLBACK_API_KEY empty to disable.
GLORIA_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
GLORIA_FALLBACK_API_KEY=
GLORIA_FALLBACK_MODEL_NAME=openai/gpt-oss-120b

# Optional third provider, tried after the fallback.
GLORIA_FALLBACK2_BASE_URL=https://api.groq.com/openai/v1
GLORIA_FALLBACK2_API_KEY=
GLORIA_FALLBACK2_MODEL_NAME=openai/gpt-oss-120b

# === Retrieval tuning ===
# Chroma returns cosine distance (0 identical, 2 opposite).
# Above this value we treat retrieval as too weak and refuse.
WEAK_DISTANCE_THRESHOLD=0.55

# === CORS ===
# Comma-separated list of allowed origins for the frontend.
CORS_ORIGINS=http://localhost:3000

# === Data folders (relative to backend/) ===
UNIVERSITY_DATA_DIR=./data/university
HEC_DATA_DIR=./data/hec
PROCESSED_DIR=./data/processed
