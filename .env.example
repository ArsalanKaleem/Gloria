# Root-level .env — read automatically by docker-compose.
#
# Only one value is needed here: the Gloria API key that the frontend
# container will use to reach the backend. Create it AFTER the backend
# is running for the first time:
#
#   docker compose up -d db backend
#   docker compose exec backend python -m scripts.create_api_key sau-portal
#
# Copy the printed FULL KEY into the value below, then:
#
#   docker compose up -d frontend
#
GLORIA_API_KEY=gl_pub_xxxxxxxx.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
