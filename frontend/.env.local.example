# URL of the Gloria backend as seen from the Next.js server.
# Local dev:          http://localhost:8000
# Docker Compose:     http://backend:8000
GLORIA_API_URL=http://localhost:8000

# Gloria API key created with:
#   python -m scripts.create_api_key sau-dev
# Paste the FULL KEY here (the prefix.secret string).
GLORIA_API_KEY=gl_pub_xxxxxxxx.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
